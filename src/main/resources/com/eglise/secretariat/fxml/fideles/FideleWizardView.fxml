<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eglise.secretariat.controllers.fideles.FideleWizardController"
            fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="20.0" style="-fx-padding: 24px;" alignment="TOP_CENTER">
        
        <!-- Wizard Card Container -->
        <VBox maxWidth="920.0" styleClass="card-accent-navy" spacing="20.0" style="-fx-padding: 0;">
            
            <!-- Wizard Header -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 20px 24px; -fx-background-color: #f8fafc; -fx-border-color: #e0e3e5 transparent transparent transparent; -fx-border-width: 1px;">
                <Label text="👤" style="-fx-font-size: 24px;" />
                <VBox spacing="2.0">
                    <Label text="Formulaire d'Inscription - Nouveau Fidèle" styleClass="font-title-lg" style="-fx-font-size: 18px;" />
                    <Label text="Remplissez les étapes pour enregistrer un nouveau membre dans le registre de l'église." styleClass="font-body-muted" />
                </VBox>
            </HBox>

            <!-- Stepper Indicators -->
            <HBox alignment="CENTER" spacing="32.0" style="-fx-padding: 12px 24px; -fx-background-color: #ffffff; -fx-border-color: transparent transparent #e0e3e5 transparent; -fx-border-width: 1px;">
                <HBox alignment="CENTER" spacing="8.0">
                    <Label fx:id="step1Circle" text="1" styleClass="step-circle, step-circle-active" />
                    <Label text="Identité" styleClass="font-label-sm" />
                </HBox>
                <Label text="──" style="-fx-text-fill: #cbd5e1;" />
                <HBox alignment="CENTER" spacing="8.0">
                    <Label fx:id="step2Circle" text="2" styleClass="step-circle" />
                    <Label text="Contacts &amp; Parents" styleClass="font-label-sm" />
                </HBox>
                <Label text="──" style="-fx-text-fill: #cbd5e1;" />
                <HBox alignment="CENTER" spacing="8.0">
                    <Label fx:id="step3Circle" text="3" styleClass="step-circle" />
                    <Label text="Matrimoniale" styleClass="font-label-sm" />
                </HBox>
                <Label text="──" style="-fx-text-fill: #cbd5e1;" />
                <HBox alignment="CENTER" spacing="8.0">
                    <Label fx:id="step4Circle" text="4" styleClass="step-circle" />
                    <Label text="Spirituel &amp; Dîme" styleClass="font-label-sm" />
                </HBox>
            </HBox>

            <!-- STEP 1 PANEL -->
            <VBox fx:id="step1Panel" spacing="16.0" style="-fx-padding: 24px;">
                <Label text="Étape 1 : Identité Civile &amp; Informations Générales" styleClass="font-title-lg" style="-fx-text-fill: #00236f;" />
                <GridPane hgap="16.0" vgap="14.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" />
                        <ColumnConstraints percentWidth="50.0" />
                    </columnConstraints>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Nom de famille *" styleClass="font-label-sm" />
                        <TextField fx:id="txtNom" promptText="ex: KOUASSI" styleClass="text-input" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Prénom(s) *" styleClass="font-label-sm" />
                        <TextField fx:id="txtPrenoms" promptText="ex: Jean-Paul" styleClass="text-input" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Sexe *" styleClass="font-label-sm" />
                        <ComboBox fx:id="comboSexe" maxWidth="Infinity" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Date de Naissance" styleClass="font-label-sm" />
                        <DatePicker fx:id="dpDateNaissance" maxWidth="Infinity" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="Lieu de Naissance" styleClass="font-label-sm" />
                        <TextField fx:id="txtLieuNaissance" promptText="ex: Lomé" styleClass="text-input" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label text="Ethnie" styleClass="font-label-sm" />
                        <TextField fx:id="txtEthnie" promptText="ex: Éwé, Mina, Kabyè..." styleClass="text-input" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
                        <Label text="Profession / Métier" styleClass="font-label-sm" />
                        <TextField fx:id="txtProfession" promptText="ex: Comptable, Enseignant..." styleClass="text-input" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                        <Label text="Niveau d'étude" styleClass="font-label-sm" />
                        <TextField fx:id="txtNiveauEtude" promptText="ex: BAC+3, Master, Secondaire..." styleClass="text-input" />
                    </VBox>
                </GridPane>
            </VBox>

            <!-- STEP 2 PANEL -->
            <VBox fx:id="step2Panel" spacing="16.0" style="-fx-padding: 24px;">
                <Label text="Étape 2 : Coordonnées, Domicile &amp; Filiation" styleClass="font-title-lg" style="-fx-text-fill: #00236f;" />
                <GridPane hgap="16.0" vgap="14.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" />
                        <ColumnConstraints percentWidth="50.0" />
                    </columnConstraints>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Téléphone Mobile *" styleClass="font-label-sm" />
                        <TextField fx:id="txtTelephone" promptText="+228 90 00 00 00" styleClass="text-input" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Contact Moov / Secondaire" styleClass="font-label-sm" />
                        <TextField fx:id="txtContactMoov" promptText="+228 98 00 00 00" styleClass="text-input" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Adresse Email" styleClass="font-label-sm" />
                        <TextField fx:id="txtEmail" promptText="membre@email.com" styleClass="text-input" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Quartier de Résidence" styleClass="font-label-sm" />
                        <TextField fx:id="txtQuartier" promptText="ex: Adidogomé" styleClass="text-input" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnSpan="2" GridPane.rowIndex="2">
                        <Label text="Adresse Complète" styleClass="font-label-sm" />
                        <TextField fx:id="txtAdresse" promptText="Rue, numéro de maison, repères..." styleClass="text-input" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
                        <Label text="Nom &amp; Prénom du Père" styleClass="font-label-sm" />
                        <HBox spacing="6.0">
                            <TextField fx:id="txtNomPere" promptText="Nom" HBox.hgrow="ALWAYS" styleClass="text-input" />
                            <TextField fx:id="txtPrenomPere" promptText="Prénom" HBox.hgrow="ALWAYS" styleClass="text-input" />
                        </HBox>
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                        <Label text="Nom &amp; Prénom de la Mère" styleClass="font-label-sm" />
                        <HBox spacing="6.0">
                            <TextField fx:id="txtNomMere" promptText="Nom" HBox.hgrow="ALWAYS" styleClass="text-input" />
                            <TextField fx:id="txtPrenomMere" promptText="Prénom" HBox.hgrow="ALWAYS" styleClass="text-input" />
                        </HBox>
                    </VBox>
                </GridPane>
            </VBox>

            <!-- STEP 3 PANEL -->
            <VBox fx:id="step3Panel" spacing="16.0" style="-fx-padding: 24px;">
                <Label text="Étape 3 : Situation Matrimoniale &amp; Famille" styleClass="font-title-lg" style="-fx-text-fill: #00236f;" />
                <GridPane hgap="16.0" vgap="14.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" />
                        <ColumnConstraints percentWidth="50.0" />
                    </columnConstraints>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Statut Matrimonial" styleClass="font-label-sm" />
                        <ComboBox fx:id="comboStatutMatrimonial" maxWidth="Infinity" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Date de Mariage" styleClass="font-label-sm" />
                        <DatePicker fx:id="dpDateMariage" maxWidth="Infinity" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Nom &amp; Prénom du Conjoint" styleClass="font-label-sm" />
                        <TextField fx:id="txtNomConjoint" promptText="Nom du conjoint" styleClass="text-input" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Confession de Foi du Conjoint" styleClass="font-label-sm" />
                        <TextField fx:id="txtConfessionConjoint" promptText="ex: Évangélique, Catholique..." styleClass="text-input" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="Église de Célébration du Mariage" styleClass="font-label-sm" />
                        <TextField fx:id="txtEgliseMariage" promptText="Église du mariage" styleClass="text-input" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label text="Pasteur Célébrant" styleClass="font-label-sm" />
                        <TextField fx:id="txtPasteurMariage" promptText="Nom du pasteur" styleClass="text-input" />
                    </VBox>

                    <HBox spacing="16.0" GridPane.columnSpan="2" GridPane.rowIndex="3">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label text="Nombre de Garçons" styleClass="font-label-sm" />
                            <Spinner fx:id="spinGarcons" editable="true" maxWidth="Infinity" />
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label text="Nombre de Filles" styleClass="font-label-sm" />
                            <Spinner fx:id="spinFilles" editable="true" maxWidth="Infinity" />
                        </VBox>
                    </HBox>
                </GridPane>
            </VBox>

            <!-- STEP 4 PANEL -->
            <VBox fx:id="step4Panel" spacing="16.0" style="-fx-padding: 24px;">
                <Label text="Étape 4 : Parcours Spirituel &amp; Conformité Administrative" styleClass="font-title-lg" style="-fx-text-fill: #00236f;" />
                <GridPane hgap="16.0" vgap="14.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" />
                        <ColumnConstraints percentWidth="50.0" />
                    </columnConstraints>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Date de Conversion" styleClass="font-label-sm" />
                        <DatePicker fx:id="dpDateConversion" maxWidth="Infinity" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Église de Conversion" styleClass="font-label-sm" />
                        <TextField fx:id="txtEgliseConversion" promptText="Église" styleClass="text-input" />
                    </VBox>

                    <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <CheckBox fx:id="chkBaptise" text="Baptisé(e) d'eau par immersion" selected="true" styleClass="font-body-md" />
                        <DatePicker fx:id="dpDateBapteme" promptText="Date du baptême d'eau" maxWidth="Infinity" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Lieu &amp; Pasteur du Baptême" styleClass="font-label-sm" />
                        <TextField fx:id="txtLieuBapteme" promptText="Lieu du baptême" styleClass="text-input" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="Baptême du Saint-Esprit" styleClass="font-label-sm" />
                        <DatePicker fx:id="dpDateBaptemeEsprit" promptText="Date" maxWidth="Infinity" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label text="Date d'intégration paroissiale" styleClass="font-label-sm" />
                        <DatePicker fx:id="dpDateIntegration" maxWidth="Infinity" />
                    </VBox>

                    <VBox spacing="8.0" GridPane.columnSpan="2" GridPane.rowIndex="3" styleClass="card" style="-fx-padding: 12px; -fx-background-color: #f8fafc;">
                        <Label text="Engagements &amp; Cotisations" styleClass="font-title-lg" style="-fx-font-size: 14px;" />
                        <HBox spacing="20.0">
                            <CheckBox fx:id="chkCarteMembre" text="Carte de membre valide" selected="true" />
                            <CheckBox fx:id="chkCarnetDime" text="Carnet de dîme valide" selected="true" />
                            <CheckBox fx:id="chkPayeDimes" text="Paye les dîmes régulièrement" selected="true" />
                        </HBox>
                        <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 6px 0 0 0;">
                            <Label text="Fréquence habituelle :" styleClass="font-label-sm" />
                            <ComboBox fx:id="comboFrequenceDime" prefWidth="200.0" />
                        </HBox>
                    </VBox>
                </GridPane>
            </VBox>

            <!-- Wizard Footer Buttons -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 16px 24px; -fx-background-color: #f8fafc; -fx-border-color: #e0e3e5 transparent transparent transparent; -fx-border-width: 1px;">
                <Button text="Annuler" onAction="#handleCancel" styleClass="btn-outline" />
                <Region HBox.hgrow="ALWAYS" />
                <ProgressIndicator fx:id="loadingIndicator" maxHeight="20.0" maxWidth="20.0" visible="false" />
                <Button fx:id="prevStepBtn" text="◀ Précédent" onAction="#handlePrevStep" styleClass="btn-outline" />
                <Button fx:id="nextStepBtn" text="Suivant ▶" onAction="#handleNextStep" styleClass="btn-primary" />
                <Button fx:id="submitBtn" text="💾 Enregistrer le Fidèle" onAction="#handleSubmit" styleClass="btn-secondary" visible="false" managed="false" />
            </HBox>

        </VBox>

    </VBox>

</ScrollPane>
