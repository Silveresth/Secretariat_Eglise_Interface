<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eglise.secretariat.controllers.fideles.FidelesListController"
      spacing="16.0" style="-fx-padding: 20px;">

    <!-- Page Header & Main Actions -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="2.0">
            <Label text="Annuaire des Fidèles" styleClass="font-display-lg" style="-fx-font-size: 22px;" />
            <Label text="Consultez, filtrez et gérez le registre général des membres inscrits à l'église." styleClass="font-body-muted" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="➕ Inscrire un Fidèle" onAction="#handleNewFidele" styleClass="btn-primary" style="-fx-padding: 8px 16px; -fx-font-size: 13px;" />
    </HBox>

    <!-- Filters Row Card -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="card" style="-fx-padding: 12px 16px;">
        <TextField fx:id="searchField" promptText="🔍 Rechercher par nom, prénom, téléphone..." prefWidth="320.0" styleClass="text-input" />
        <ComboBox fx:id="quartierCombo" promptText="Quartier" prefWidth="180.0" />
        <ComboBox fx:id="baptiseCombo" promptText="Statut Baptême" prefWidth="160.0" />
        
        <Button text="🔍 Filtrer" onAction="#handleSearch" styleClass="btn-primary" style="-fx-padding: 7px 14px; -fx-font-size: 12px;" />
        <Button text="🔄 Réinitialiser" onAction="#handleResetFilters" styleClass="btn-outline" style="-fx-padding: 7px 14px; -fx-font-size: 12px;" />

        <Region HBox.hgrow="ALWAYS" />
        <ProgressIndicator fx:id="loadingIndicator" maxHeight="18.0" maxWidth="18.0" visible="false" />
    </HBox>

    <!-- Data Table Card -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="10.0" style="-fx-padding: 0;">
        <TableView fx:id="fidelesTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colPhoto" text="PROFIL" prefWidth="80.0" style="-fx-alignment: center;" />
                <TableColumn fx:id="colNomPrenom" text="NOM &amp; PRÉNOM(S)" prefWidth="300.0" style="-fx-alignment: center;" />
                <TableColumn fx:id="colTelephone" text="TÉLÉPHONE" prefWidth="180.0" style="-fx-alignment: center;" />
                <TableColumn fx:id="colQuartier" text="QUARTIER" prefWidth="180.0" style="-fx-alignment: center;" />
                <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="220.0" style="-fx-alignment: center;" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Pagination Controls -->
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 10px 16px; -fx-background-color: #f8fafc; -fx-border-color: #e0e3e5 transparent transparent transparent; -fx-border-width: 1px;">
            <Label fx:id="paginationLabel" text="Affichage de 1 à 15 sur 150 fidèles" styleClass="font-label-sm" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="6.0">
                <Button fx:id="prevPageBtn" text="◀ Précédent" onAction="#handlePrevPage" styleClass="btn-outline" style="-fx-font-size: 11px; -fx-padding: 4px 10px;" />
                <Button fx:id="nextPageBtn" text="Suivant ▶" onAction="#handleNextPage" styleClass="btn-outline" style="-fx-font-size: 11px; -fx-padding: 4px 10px;" />
            </HBox>
        </HBox>
    </VBox>

</VBox>
