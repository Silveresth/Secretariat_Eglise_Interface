<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eglise.secretariat.controllers.fideles.FidelesListController"
      spacing="16.0" style="-fx-padding: 24px;">

    <!-- Page Header & Main Actions -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="2.0">
            <Label text="Annuaire des Fidèles" styleClass="font-display-lg" style="-fx-font-size: 24px;" />
            <Label text="Consultez, recherchez et gérez les membres inscrits à l'église." styleClass="font-body-muted" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="+ Inscrire un Fidèle" onAction="#handleNewFidele" styleClass="btn-primary" style="-fx-padding: 9px 18px;" />
    </HBox>

    <!-- Filters Row -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card" style="-fx-padding: 12px 16px;">
        <TextField fx:id="searchField" promptText="🔍 Rechercher par nom, prénom, téléphone..." prefWidth="300.0" styleClass="text-input" />
        <ComboBox fx:id="quartierCombo" prefWidth="180.0" />
        <ComboBox fx:id="baptiseCombo" prefWidth="150.0" />
        <ComboBox fx:id="dimeCombo" prefWidth="150.0" />
        
        <Button text="Filtrer" onAction="#handleSearch" styleClass="btn-outline" />

        <Region HBox.hgrow="ALWAYS" />
        <ProgressIndicator fx:id="loadingIndicator" maxHeight="20.0" maxWidth="20.0" />
    </HBox>

    <!-- Data Table Card -->
    <VBox styleClass="card-accent-navy" VBox.vgrow="ALWAYS" spacing="10.0" style="-fx-padding: 0;">
        <TableView fx:id="fidelesTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colPhoto" text="PHOTO" prefWidth="60.0" style="-fx-alignment: center;" />
                <TableColumn fx:id="colNomPrenom" text="NOM &amp; PRÉNOM(S)" prefWidth="220.0" />
                <TableColumn fx:id="colTelephone" text="TÉLÉPHONE" prefWidth="140.0" />
                <TableColumn fx:id="colQuartier" text="QUARTIER" prefWidth="130.0" />
                <TableColumn fx:id="colMatrimonial" text="SITUATION" prefWidth="130.0" />
                <TableColumn fx:id="colCarte" text="CARTE" prefWidth="110.0" style="-fx-alignment: center;" />
                <TableColumn fx:id="colDime" text="DÎME" prefWidth="110.0" style="-fx-alignment: center;" />
                <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="240.0" style="-fx-alignment: center-right;" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Pagination Controls -->
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 12px 16px; -fx-background-color: #f8fafc; -fx-border-color: #e0e3e5 transparent transparent transparent; -fx-border-width: 1px;">
            <Label fx:id="paginationLabel" text="Affichage de 1 à 15 sur 150 fidèles" styleClass="font-label-sm" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="6.0">
                <Button fx:id="prevPageBtn" text="◀ Précédent" onAction="#handlePrevPage" styleClass="btn-outline" style="-fx-font-size: 11px; -fx-padding: 4px 10px;" />
                <Button fx:id="nextPageBtn" text="Suivant ▶" onAction="#handleNextPage" styleClass="btn-outline" style="-fx-font-size: 11px; -fx-padding: 4px 10px;" />
            </HBox>
        </HBox>
    </VBox>

</VBox>
