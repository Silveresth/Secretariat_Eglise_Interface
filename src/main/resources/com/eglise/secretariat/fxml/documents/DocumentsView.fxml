<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eglise.secretariat.controllers.documents.DocumentsController"
            fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="24.0" style="-fx-padding: 24px 32px;" alignment="TOP_CENTER">

        <VBox maxWidth="1280.0" spacing="20.0">

            <!-- En-tête de section -->
            <VBox spacing="4.0">
                <Label text="Édition de Fiches &amp; Attestations" styleClass="font-display-lg" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #00236f;" />
                <Label text="Sélectionnez un fidèle ou effectuez une recherche pour générer sa fiche d'inscription ou sa lettre de recommandation." styleClass="font-body-muted" style="-fx-font-size: 14px; -fx-text-fill: #64748b;" />
            </VBox>

            <!-- Layout principal 2 colonnes -->
            <GridPane hgap="20.0" vgap="20.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="45.0" />
                    <ColumnConstraints percentWidth="55.0" />
                </columnConstraints>

                <!-- COLONNE GAUCHE: Recherche + Mini-Tableau (Style Annuaire des fidèles) + Carte Options Lettre Pro -->
                <VBox spacing="20.0" GridPane.columnIndex="0">
                    
                    <!-- Carte 1: Recherche & Tableau des Fidèles (Style Annuaire des Fidèles) -->
                    <VBox styleClass="card" spacing="14.0" style="-fx-padding: 20px; -fx-background-color: white; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-width: 1px; -fx-effect: dropshadow(three-pass-box, rgba(0,35,111,0.04), 8, 0, 0, 2);">
                        
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Sélection du Fidèle" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #00236f;" HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblTableSubtext" text="3 derniers inscrits" style="-fx-font-size: 12px; -fx-text-fill: #64748b; -fx-font-style: italic;" />
                        </HBox>
                        
                        <!-- Barre de recherche -->
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <TextField fx:id="searchFideleInput" promptText="Rechercher par nom ou prénom..." onAction="#handleSearchFidele" styleClass="text-input" HBox.hgrow="ALWAYS" style="-fx-padding: 8px 12px; -fx-font-size: 13px;" />
                            <Button text="🔍 Rechercher" onAction="#handleSearchFidele" styleClass="btn-primary" style="-fx-padding: 8px 14px; -fx-cursor: hand; -fx-font-size: 12.5px;" />
                            <Button text="🔄 Réinitialiser" onAction="#handleResetSearch" styleClass="btn-outline" style="-fx-padding: 8px 14px; -fx-cursor: hand; -fx-font-size: 12.5px;" />
                        </HBox>

                        <!-- Mini Tableau du fidèle inspire de l'Annuaire -->
                        <VBox spacing="0.0" style="-fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-overflow: hidden;">
                            <TableView fx:id="tableSearchResult" prefHeight="185.0" styleClass="table-view">
                                <columns>
                                    <TableColumn fx:id="colNomComplet" text="NOM &amp; PRÉNOM(S)" prefWidth="200.0" styleClass="col-header-left" style="-fx-alignment: CENTER-LEFT;" />
                                    <TableColumn fx:id="colActions" text="ACTIONS DISPONIBLES" prefWidth="220.0" style="-fx-alignment: CENTER;" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>

                    </VBox>

                    <!-- Carte 2: Configuration Pro de la Lettre de Recommandation (Masquée par défaut) -->
                    <VBox fx:id="cardLettreOptions" visible="false" managed="false" styleClass="card" spacing="16.0" style="-fx-padding: 20px; -fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-effect: dropshadow(three-pass-box, rgba(0,35,111,0.05), 10, 0, 0, 3);">
                        
                        <VBox spacing="4.0">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="✉️ Options de la Lettre de Recommandation" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #00236f;" />
                            </HBox>
                            <Label text="Personnalisez le motif et le destinataire avant impression ou export PDF." style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
                        </VBox>
                        
                        <Separator style="-fx-opacity: 0.5;" />

                        <VBox spacing="14.0">
                            
                            <!-- Libellés / Motifs avec design clair et lisible -->
                            <VBox spacing="8.0">
                                <Label text="Objet / Motif officiel de la demande *" styleClass="font-label-sm" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                                
                                <HBox spacing="16.0" alignment="CENTER_LEFT" style="-fx-background-color: #f8fafc; -fx-padding: 10px 14px; -fx-background-radius: 8px; -fx-border-color: #cbd5e1; -fx-border-radius: 8px;">
                                    <RadioButton fx:id="radioTransfert" text="Transfert d'Église" selected="true" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #0f172a; -fx-cursor: hand;" />
                                    <RadioButton fx:id="radioVoyage" text="Voyage" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #0f172a; -fx-cursor: hand;" />
                                    <RadioButton fx:id="radioTravail" text="Emploi / Travail" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #0f172a; -fx-cursor: hand;" />
                                </HBox>
                            </VBox>

                            <GridPane hgap="12.0" vgap="12.0">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50.0" />
                                    <ColumnConstraints percentWidth="50.0" />
                                </columnConstraints>

                                <VBox spacing="6.0" GridPane.columnIndex="0">
                                    <Label text="Église / Paroisse de destination" styleClass="font-label-sm" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                                    <TextField fx:id="txtEgliseDestination" promptText="ex: Temple de Kpalimé" styleClass="text-input" text="Temple de Kpalimé" style="-fx-padding: 8px 12px; -fx-font-size: 13px;" />
                                </VBox>

                                <VBox spacing="6.0" GridPane.columnIndex="1">
                                    <Label text="Pasteur Signataire" styleClass="font-label-sm" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                                    <ComboBox fx:id="comboPasteurSignataire" maxWidth="Infinity" style="-fx-padding: 4px 8px; -fx-font-size: 13px;" />
                                </VBox>
                            </GridPane>

                        </VBox>

                        <Button fx:id="btnGenererLettreHtml" text="🔄 Actualiser l'Aperçu de la Lettre" onAction="#handleUpdateLettrePreview" maxWidth="Infinity" styleClass="btn-primary" style="-fx-cursor: hand; -fx-padding: 10px; -fx-font-size: 13px; -fx-font-weight: bold;" />

                    </VBox>

                </VBox>

                <!-- COLONNE DROITE: Aperçu du Document HTML (WebView format A4) -->
                <VBox styleClass="card" spacing="14.0" GridPane.columnIndex="1" style="-fx-padding: 20px; -fx-background-color: white; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-width: 1px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 2);">
                    
                    <!-- Barre de titre de l'aperçu & Bouton d'exportation PDF -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblDocTypeTitle" text="Aperçu du Document (Format A4)" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                            <Label fx:id="lblDocTargetName" text="Sélectionnez un fidèle à gauche" style="-fx-font-size: 13px; -fx-text-fill: #64748b;" />
                        </VBox>
                        <ProgressIndicator fx:id="loadingIndicator" maxHeight="22.0" maxWidth="22.0" visible="false" />
                        <Button fx:id="btnExportPdf" text="📥 Exporter / Imprimer PDF" onAction="#handleExportPdf" styleClass="btn-secondary" style="-fx-cursor: hand; -fx-padding: 9px 16px; -fx-font-weight: bold;" />
                    </HBox>

                    <Separator style="-fx-opacity: 0.5;" />

                    <!-- Conteneur Webview A4 parfaitement cadrasé -->
                    <VBox alignment="TOP_CENTER" style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 6px;" VBox.vgrow="ALWAYS">
                        <WebView fx:id="webViewDocument" minHeight="560.0" maxHeight="600.0" prefHeight="580.0" />
                    </VBox>

                </VBox>

            </GridPane>

        </VBox>

    </VBox>

</ScrollPane>
