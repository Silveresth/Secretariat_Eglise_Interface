<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eglise.secretariat.controllers.dashboard.DashboardController"
            fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="20.0" style="-fx-padding: 24px;">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT">
            <VBox spacing="2.0">
                <Label text="Tableau de Bord" styleClass="font-display-lg" style="-fx-font-size: 24px;" />
                <Label text="Aperçu général des activités paroissiales, statistiques et flux récents." styleClass="font-body-muted" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="10.0">
                <ProgressIndicator fx:id="loadingIndicator" maxHeight="20.0" maxWidth="20.0" />
                <Button fx:id="refreshBtn" text="🔄 Actualiser" onAction="#handleRefresh" styleClass="btn-outline" />
            </HBox>
        </HBox>

        <!-- KPI Cards Grid -->
        <GridPane hgap="16.0" vgap="16.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="25.0" />
                <ColumnConstraints percentWidth="25.0" />
                <ColumnConstraints percentWidth="25.0" />
                <ColumnConstraints percentWidth="25.0" />
            </columnConstraints>

            <!-- Card 1: Total Fidèles Actifs -->
            <VBox styleClass="card-accent-navy" GridPane.columnIndex="0">
                <HBox alignment="CENTER_LEFT">
                    <Label text="TOTAL FIDÈLES ACTIFS" styleClass="font-label-sm" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="👥" style="-fx-font-size: 16px;" />
                </HBox>
                <HBox alignment="BASELINE_LEFT" spacing="8.0" style="-fx-padding: 10px 0 0 0;">
                    <Label fx:id="totalInscritsLabel" text="1,240" styleClass="font-display-lg" style="-fx-font-size: 26px; -fx-text-fill: #191c1e;" />
                    <Label text="+5%" styleClass="badge-success" />
                </HBox>
            </VBox>

            <!-- Card 2: Membres Baptisés -->
            <VBox styleClass="card-accent-navy" GridPane.columnIndex="1">
                <HBox alignment="CENTER_LEFT">
                    <Label text="MEMBRES BAPTISÉS" styleClass="font-label-sm" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="💧" style="-fx-font-size: 16px;" />
                </HBox>
                <HBox alignment="BASELINE_LEFT" spacing="8.0" style="-fx-padding: 10px 0 0 0;">
                    <Label fx:id="membresBaptisesLabel" text="850" styleClass="font-display-lg" style="-fx-font-size: 26px; -fx-text-fill: #191c1e;" />
                </HBox>
            </VBox>

            <!-- Card 3: Nouveaux Inscrits -->
            <VBox styleClass="card-accent-gold" GridPane.columnIndex="2">
                <HBox alignment="CENTER_LEFT">
                    <Label text="NOUVEAUX INSCRITS (MOIS)" styleClass="font-label-sm" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="✨" style="-fx-font-size: 16px;" />
                </HBox>
                <HBox alignment="BASELINE_LEFT" spacing="8.0" style="-fx-padding: 10px 0 0 0;">
                    <Label fx:id="nouveauxInscritsLabel" text="12" styleClass="font-display-lg" style="-fx-font-size: 26px; -fx-text-fill: #191c1e;" />
                </HBox>
            </VBox>

            <!-- Card 4: Taux Dîme -->
            <VBox styleClass="card-accent-gold" GridPane.columnIndex="3">
                <HBox alignment="CENTER_LEFT">
                    <Label text="TAUX DE DÎMES À JOUR" styleClass="font-label-sm" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="💳" style="-fx-font-size: 16px;" />
                </HBox>
                <HBox alignment="BASELINE_LEFT" spacing="8.0" style="-fx-padding: 10px 0 0 0;">
                    <Label fx:id="tauxDimesLabel" text="85%" styleClass="font-display-lg" style="-fx-font-size: 26px; -fx-text-fill: #191c1e;" />
                </HBox>
            </VBox>

        </GridPane>

        <!-- Charts Grid (Flux Mensuels & Répartition Quartier) -->
        <GridPane hgap="16.0" vgap="16.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="60.0" />
                <ColumnConstraints percentWidth="40.0" />
            </columnConstraints>

            <!-- Flux Mensuel Bar Chart Card -->
            <VBox styleClass="card-accent-navy" GridPane.columnIndex="0" prefHeight="320.0">
                <Label text="Flux Mensuels d'Inscriptions" styleClass="font-title-lg" />
                <BarChart fx:id="fluxMensuelChart" legendVisible="false" animated="false" VBox.vgrow="ALWAYS" prefHeight="260.0">
                    <xAxis>
                        <CategoryAxis fx:id="fluxXAxis" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="fluxYAxis" />
                    </yAxis>
                </BarChart>
            </VBox>

            <!-- Répartition par Quartier Pie Chart Card -->
            <VBox styleClass="card-accent-navy" GridPane.columnIndex="1" prefHeight="320.0">
                <Label text="Répartition par Quartier" styleClass="font-title-lg" />
                <PieChart fx:id="repartitionQuartierChart" legendVisible="true" animated="false" VBox.vgrow="ALWAYS" prefHeight="260.0" />
            </VBox>

        </GridPane>

        <!-- Recent Activities Card -->
        <VBox styleClass="card-accent-navy" spacing="12.0">
            <HBox alignment="CENTER_LEFT">
                <Label text="Derniers Fidèles Enregistrés" styleClass="font-title-lg" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Voir tout l'annuaire →" onAction="#handleViewAllFideles" styleClass="btn-ghost" />
            </HBox>

            <TableView fx:id="recentFidelesTable" prefHeight="220.0">
                <columns>
                    <TableColumn fx:id="colNom" text="NOM DU FIDÈLE" prefWidth="300.0" />
                    <TableColumn fx:id="colDate" text="DATE D'INSCRIPTION" prefWidth="180.0" />
                    <TableColumn fx:id="colStatut" text="STATUT DÎME" prefWidth="150.0" />
                    <TableColumn fx:id="colAction" text="ACTION" prefWidth="120.0" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

    </VBox>

</ScrollPane>
